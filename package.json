{
  "name": "primedesk",
  "productName": "PrimeDesk",
  "version": "1.2.1",
  "description": "Enterprise WebRTC Remote Desktop Support Suite",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/signaling.js",
    "build:win": "electron-builder --win --publish never",
    "dist": "electron-builder --win --publish never",
    "test": "echo \"No test specified\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basliel26/PrimeDesk.git"
  },
  "keywords": [
    "remote-desktop",
    "webrtc",
    "electron",
    "anydesk-alternative",
    "enterprise-support"
  ],
  "author": "Basliel Getu",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.primedesk.support",
    "productName": "PrimeDesk",
    "copyright": "Copyright © 2026 Basliel Getu",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "src/native/PrimeInput.exe",
        "to": "native/PrimeInput.exe"
      },
      {
        "from": "src/native/PrimeClipboard.exe",
        "to": "native/PrimeClipboard.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/primedesk.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrimeDesk Support",
      "artifactName": "PrimeDesk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PrimeDesk-Portable-${version}.${ext}"
    }
  }
}
